# Copiar a .env.demo. Estos valores son solo para una demostración sintética aislada.
ENVIRONMENT=demo
DJANGO_SETTINGS_MODULE=config.settings.demo
DJANGO_SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-50-characters
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,demo.example.invalid
DJANGO_CSRF_TRUSTED_ORIGINS=https://demo.example.invalid
APP_TIME_ZONE=America/Lima
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-synthetic-admin-password

DATABASE_NAME=trazametrica_demo
DATABASE_USER=trazametrica_demo
DATABASE_PASSWORD=replace-with-a-long-unique-database-password

# En publicación real use un FQDN propio; Caddy emitirá TLS automáticamente.
# Para un simulacro local HTTP: :80
DEMO_CADDY_ADDRESS=:80
DEMO_HTTP_PORT=8080
DEMO_HTTPS_PORT=8443
RELEASE_VERSION=0.1.0-rc.1
