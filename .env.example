# Copiar como .env solo para el entorno local. No utilizar estos valores en demo o producción.
ENVIRONMENT=local
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-with-at-least-50-random-characters
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost
APP_TIME_ZONE=America/Lima
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-local-synthetic-password

DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=trazametrica
DATABASE_USER=trazametrica
DATABASE_PASSWORD=replace-this-local-password

DEMO_DATASET_VERSION=1
MAX_UPLOAD_BYTES=10485760
